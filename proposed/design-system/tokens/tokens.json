{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Amendment — Living Document design tokens. Source of truth for color, type, spacing, radii, shadows, motion. Consumed by Tailwind config, CSS custom properties, and component recipes. Style-Dictionary compatible.",
  "color": {
    "primary": {
      "$description": "Midnight Indigo — institutional ink. Default button, active nav, selected card border, ink on the tab bar. The user's trail.",
      "light": { "$value": "#334155", "$type": "color", "$description": "slate-700 — hover / gradient top light" },
      "default": { "$value": "#1e293b", "$type": "color", "$description": "slate-800 — default" },
      "dark": { "$value": "#0f172a", "$type": "color", "$description": "slate-900 — active / gradient top dark" }
    },
    "action": {
      "$description": "Momentum green — action AND the crowd, one hue. Sampled from the shipped --aurora-curtain (lobe 2) at button lightness. Label is ink, not white. Replaced Oxblood 2026-08.",
      "default": { "$value": "oklch(.66 .148 160)", "$type": "color", "$description": "CTA, FAB, co-sign, counts, thresholds" },
      "hover": { "$value": "oklch(.72 .150 161)", "$type": "color" },
      "active": { "$value": "oklch(.60 .145 160)", "$type": "color", "$description": "~6 points of headroom before the ink label fails" },
      "label": { "$value": "rgb(0 0 0 / 87%)", "$type": "color", "$description": "INK. White measures 2.90:1 here; ink 6.42:1." }
    },
    "functional": {
      "$description": "Slate Blue — attention without alarm. Focus rings, progress, icon-button hover. Never brand.",
      "light": { "$value": "#94a3b8", "$type": "color", "$description": "slate-400" },
      "default": { "$value": "#64748b", "$type": "color", "$description": "slate-500 — default focus / loading" },
      "dark": { "$value": "#475569", "$type": "color", "$description": "slate-600 — hover" }
    },
    "semantic": {
      "$description": "Conventional meaning only. Never used for brand decoration.",
      "success": { "$value": "#047857", "$type": "color", "$description": "emerald-700 — bill enacted, action completed" },
      "success-soft": { "$value": "#10b981", "$type": "color", "$description": "emerald-500 — positive badges" },
      "warning": { "$value": "#b45309", "$type": "color", "$description": "amber-700 — admin notices, non-blocking" },
      "warning-soft": { "$value": "#f59e0b", "$type": "color", "$description": "amber-500 — warning icon fills" },
      "danger": { "$value": "#dc2626", "$type": "color", "$description": "red-600 — destructive, error states" },
      "danger-soft": { "$value": "#ef4444", "$type": "color", "$description": "red-500 — error badges" }
    },
    "neutral": {
      "$description": "Zinc — warm-gray paper. Complements slate-blue better than pure gray.",
      "white": { "$value": "#ffffff", "$type": "color" },
      "zinc-50": { "$value": "#fafafa", "$type": "color" },
      "zinc-100": { "$value": "#f4f4f5", "$type": "color", "$description": "page canvas (light)" },
      "zinc-200": { "$value": "#e4e4e7", "$type": "color" },
      "zinc-400": { "$value": "#a1a1aa", "$type": "color" },
      "zinc-500": { "$value": "#71717a", "$type": "color" },
      "zinc-700": { "$value": "#3f3f46", "$type": "color" },
      "zinc-800": { "$value": "#27272a", "$type": "color" },
      "zinc-900": { "$value": "#18181b", "$type": "color", "$description": "page canvas (dark)" },
      "black": { "$value": "#000000", "$type": "color" }
    },
    "text": {
      "$description": "Opacity on black/white per Apple HIG three-rung. Safe ONLY because the aurora is monochromatic low-chroma.",
      "primary": { "$value": "rgb(0 0 0 / 87%)", "$type": "color" },
      "secondary": { "$value": "rgb(0 0 0 / 55%)", "$type": "color" },
      "tertiary": { "$value": "rgb(0 0 0 / 38%)", "$type": "color" },
      "primary-dark": { "$value": "rgb(255 255 255 / 87%)", "$type": "color" },
      "secondary-dark": { "$value": "rgb(255 255 255 / 55%)", "$type": "color" },
      "tertiary-dark": { "$value": "rgb(255 255 255 / 38%)", "$type": "color" },
      "secondary-high-contrast": { "$value": "rgb(0 0 0 / 75%)", "$type": "color", "$description": "Apply when prefers-contrast: more" },
      "secondary-high-contrast-dark": { "$value": "rgb(255 255 255 / 75%)", "$type": "color" }
    },
    "border": {
      "hairline": { "$value": "rgb(0 0 0 / 5%)", "$type": "color" },
      "hairline-dark": { "$value": "rgb(255 255 255 / 20%)", "$type": "color" },
      "subtle": { "$value": "rgb(0 0 0 / 10%)", "$type": "color" },
      "subtle-dark": { "$value": "rgb(255 255 255 / 10%)", "$type": "color" },
      "dashed-empty": { "$value": "rgb(0 0 0 / 30%)", "$type": "color", "$description": "card-empty 2px dashed only" }
    },
    "aurora": {
      "$description": "Three-stop Blue Hour gradient. Painted in oklch behind every surface. Do not broaden the hue range.",
      "light": {
        "lobe-indigo": { "$value": "radial-gradient(ellipse 72% 55% at 15% 8%, oklch(0.88 0.05 250 / 0.40), transparent)", "$type": "gradient" },
        "lobe-slate": { "$value": "radial-gradient(ellipse 58% 46% at 85% 20%, oklch(0.90 0.04 270 / 0.32), transparent)", "$type": "gradient" },
        "lobe-parchment": { "$value": "radial-gradient(ellipse 60% 50% at 50% 90%, oklch(0.94 0.03 60 / 0.28), transparent)", "$type": "gradient" }
      },
      "dark": {
        "lobe-indigo": { "$value": "radial-gradient(ellipse 72% 55% at 15% 8%, oklch(0.30 0.08 250 / 0.45), transparent)", "$type": "gradient" },
        "lobe-slate": { "$value": "radial-gradient(ellipse 58% 46% at 85% 20%, oklch(0.25 0.06 270 / 0.35), transparent)", "$type": "gradient" },
        "lobe-parchment": { "$value": "radial-gradient(ellipse 60% 50% at 50% 90%, oklch(0.40 0.03 60 / 0.20), transparent)", "$type": "gradient" }
      },
      "celebration": {
        "$description": "Receipt issuance only. ~15% chroma deepening for 250-400ms then settles back.",
        "lobe-indigo": { "$value": "radial-gradient(ellipse 72% 55% at 15% 8%, oklch(0.88 0.07 250 / 0.55), transparent)", "$type": "gradient" }
      }
    },
    "canvas": {
      "page-light": { "$value": "#f4f4f5", "$type": "color" },
      "page-dark": { "$value": "#18181b", "$type": "color" },
      "paper-cream": { "$value": "oklch(0.965 0.012 85)", "$type": "color", "$description": "Archive bill text · statute excerpts · Receipt body" },
      "paper-cream-dark": { "$value": "oklch(0.20 0.010 70)", "$type": "color" },
      "paper-parchment": { "$value": "oklch(0.955 0.018 80)", "$type": "color", "$description": "Writing Desk letter canvas — letterhead stock" },
      "paper-parchment-dark": { "$value": "oklch(0.22 0.012 65)", "$type": "color" }
    }
  },
  "font": {
    "family": {
      "sans": { "$value": "'Readex Pro', ui-sans-serif, system-ui, sans-serif", "$type": "fontFamily" },
      "serif": { "$value": "Newsreader, ui-serif, Georgia, serif", "$type": "fontFamily", "$description": "Scotch roman, variable, opsz 6-72. Replaced Merriweather 2026-08 — always set an optical stop." },
      "mono": { "$value": "'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace", "$type": "fontFamily" }
    },
    "hexp": {
      "$description": "Readex Pro HEXP axis. HEXP 60 is load-bearing; 80 and 100 are rare escalations.",
      "body": { "$value": "'HEXP' 2", "$type": "fontVariationSettings" },
      "chrome": { "$value": "'wdth' 125", "$type": "fontVariationSettings", "$description": "Navbar, breadcrumbs, labels, chips, status stamps, table heads. Pair with uppercase + 0.12em tracking." },
      "display": { "$value": "'wdth' 120", "$type": "fontVariationSettings", "$description": "Hero stat numerals only. NOTE: narrower than chrome — width is not a monotonic ladder." },
      "ceremonial": { "$value": "'wdth' 125", "$type": "fontVariationSettings", "$description": "Receipt place-of-issue caption. ≤ 1 per page. The seal monogram no longer inherits this — a die owns its own proportions." }
    },
    "weight": {
      "$description": "Numeric weights. Use these directly; dark-mode auto-calibration handled in CSS layer, not by contributors.",
      "sans": {
        "thin": { "$value": 100, "$type": "fontWeight" },
        "extralight": { "$value": 200, "$type": "fontWeight" },
        "light": { "$value": 300, "$type": "fontWeight" },
        "normal": { "$value": 400, "$type": "fontWeight" },
        "medium": { "$value": 500, "$type": "fontWeight" },
        "semibold": { "$value": 600, "$type": "fontWeight" },
        "bold": { "$value": 900, "$type": "fontWeight" },
        "extrabold": { "$value": 800, "$type": "fontWeight" },
        "black": { "$value": 900, "$type": "fontWeight" }
      },
      "serif": {
        "thin": { "$value": 100, "$type": "fontWeight" },
        "light": { "$value": 300, "$type": "fontWeight" },
        "normal": { "$value": 400, "$type": "fontWeight" },
        "medium": { "$value": 500, "$type": "fontWeight" },
        "semibold": { "$value": 600, "$type": "fontWeight" },
        "bold": { "$value": 700, "$type": "fontWeight" },
        "extrabold": { "$value": 800, "$type": "fontWeight" },
        "black": { "$value": 900, "$type": "fontWeight" }
      }
    },
    "role": {
      "$description": "Composed typography roles. Use these in components; tweak via variant rather than re-composing.",
      "display-hero": { "$value": { "family": "serif", "size": "clamp(2rem, 4.5vw, 3.75rem)", "weight": 800, "lineHeight": 1.1, "tracking": "-0.01em" }, "$type": "typography" },
      "display-section": { "$value": { "family": "serif", "size": "1.5rem", "weight": 800, "lineHeight": 1.2 }, "$type": "typography" },
      "body-lead": { "$value": { "family": "sans", "size": "1.125rem", "weight": 200, "lineHeight": 1.5, "color": "secondary" }, "$type": "typography", "$description": "Marketing lead paragraphs, extralight" },
      "body": { "$value": { "family": "sans", "size": "1rem", "weight": "normal", "lineHeight": 1.5, "hexp": "body" }, "$type": "typography" },
      "body-serif": { "$value": { "family": "serif", "size": "1rem", "weight": 450, "opsz": 16, "lineHeight": 1.625 }, "$type": "typography", "$description": "AI-authored prose, Archive analysis, letter body" },
      "label-chrome": { "$value": { "family": "sans", "size": "0.75rem", "weight": "semibold", "lineHeight": 1, "tracking": "0.05em", "transform": "uppercase", "hexp": "chrome" }, "$type": "typography" },
      "metadata": { "$value": { "family": "serif", "size": "0.875rem", "weight": 420, "opsz": 16, "color": "secondary" }, "$type": "typography", "$description": "Provenance, byline, relationship descriptors. 'started by Brad Feld', 'representing you in Washington, D.C.'" },
      "caption": { "$value": { "family": "sans", "size": "0.75rem", "weight": "normal", "lineHeight": 1.25, "color": "secondary" }, "$type": "typography" },
      "code": { "$value": { "family": "mono", "size": "0.875rem", "weight": 400, "lineHeight": 1.5 }, "$type": "typography" },
      "stat-display": { "$value": { "family": "sans", "size": "clamp(2.5rem, 6vw, 4rem)", "weight": "bold", "lineHeight": 1, "tracking": "-0.01em", "hexp": "display" }, "$type": "typography", "$description": "Hero stat numerals only — '52 Legislatures', '464,269 Bills Tracked'" },
      "ceremonial": { "$value": { "family": "sans", "size": "0.6875rem", "weight": "semibold", "tracking": "0.18em", "transform": "uppercase", "hexp": "ceremonial" }, "$type": "typography", "$description": "Receipt place-of-issue caption" }
    }
  },
  "space": {
    "$description": "4px unit. Use Tailwind scale (1=4, 2=8, 4=16, 6=24, 8=32, 12=48, 16=64, 32=128).",
    "unit": { "$value": "4px", "$type": "dimension" },
    "inset": {
      "sm": { "$value": "8px", "$type": "dimension" },
      "md": { "$value": "16px", "$type": "dimension" },
      "lg": { "$value": "24px", "$type": "dimension" },
      "xl": { "$value": "32px", "$type": "dimension" }
    },
    "rhythm": {
      "section-y-mobile": { "$value": "64px", "$type": "dimension" },
      "section-y-desktop": { "$value": "128px", "$type": "dimension" },
      "card-gap": { "$value": "12px", "$type": "dimension" }
    },
    "measure": {
      "$description": "The MEASURE caps the element that holds the text, stated mobile-first in rem DERIVED FROM A COUNTED LINE. Never ch: ch is the advance width of the zero glyph of the element carrying the rule, so 65ch on a sans page shell filled with serif prose measured 636px / 97 characters. The count is the intent, the rem is the value — re-derive when a text face or role size changes. Target 69 characters, ceiling 75. Decided 2026-08-04, explorations/What 65ch Measures.html.",
      "body": { "$value": "min(28rem, 100% - 2rem)", "$type": "dimension", "$description": "69 characters of role-body-serif at 16px (average glyph 6.53px)" },
      "lede": { "$value": "min(24rem, 100% - 2rem)", "$type": "dimension", "$description": "47 characters of role-lede at 20px (average glyph 8.17px)" },
      "print": { "$value": "6.5in", "$type": "dimension", "$description": "Paper takes its measure from the margin — 1in all round on US Letter. See profilesPrint." }
    },
    "container": {
      "tight": { "$value": "48rem", "$type": "dimension", "$description": "Conversation columns, feeds. A SHELL, not a measure." },
      "normal": { "$value": "min(31rem, 100%)", "$type": "dimension", "$description": "Prose page shell = measure.body + .page's own 24px gutters. Was 65ch until 2026-08-04." },
      "wide": { "$value": "80rem", "$type": "dimension", "$description": "Navbar, footer, marketing" }
    }
  },
  "radius": {
    "$description": "Sharper for chrome/inputs, softer for content cards, softer still for floating surfaces. No 2xl, no 3xl.",
    "sm": { "$value": "0.25rem", "$type": "dimension", "$description": "inputs, chrome fragments, status pills" },
    "md": { "$value": "0.5rem", "$type": "dimension", "$description": "buttons, cards, content surfaces" },
    "lg": { "$value": "0.75rem", "$type": "dimension", "$description": "modals, FAB, floating overlays" },
    "full": { "$value": "9999px", "$type": "dimension", "$description": "pills, toggles, avatars" }
  },
  "border": {
    "hairline": { "$value": { "width": "1px", "style": "solid", "color": "border.hairline" }, "$type": "border" },
    "subtle": { "$value": { "width": "1px", "style": "solid", "color": "border.subtle" }, "$type": "border" },
    "dashed-empty": { "$value": { "width": "2px", "style": "dashed", "color": "border.dashed-empty" }, "$type": "border" }
  },
  "shadow": {
    "$description": "Slate-900 ink across the system. Two-layer per tier. Never tint by content category.",
    "flat": { "$value": "none", "$type": "shadow" },
    "whisper": {
      "$value": "0 1px 2px 0 rgb(15 23 42 / 0.04), 0 1px 1px -1px rgb(15 23 42 / 0.04)",
      "$type": "shadow",
      "$description": "material-thin, ghost-button hover, default-button rest"
    },
    "raised": {
      "$value": "0 4px 6px -1px rgb(15 23 42 / 0.12), 0 2px 4px -2px rgb(15 23 42 / 0.12)",
      "$type": "shadow",
      "$description": "material-regular, default-button hover, cards"
    },
    "floating": {
      "$value": "0 20px 25px -5px rgb(15 23 42 / 0.18), 0 8px 10px -6px rgb(15 23 42 / 0.18)",
      "$type": "shadow",
      "$description": "material-thick, modal, FAB, dropdowns, secondary-button hover"
    },
    "chrome": {
      "$value": "0 8px 16px -4px rgb(15 23 42 / 0.12), 0 3px 6px -3px rgb(15 23 42 / 0.12)",
      "$type": "shadow",
      "$description": "material-chrome (persistent navbar). Wider spread than raised."
    }
  },
  "material": {
    "$description": "Glass tiers. 50px blur (25px for chrome). Collapse to solid zinc when prefers-reduced-transparency.",
    "ultrathin": { "$value": { "bg-light": "rgb(255 255 255 / 10%)", "bg-dark": "rgb(0 0 0 / 2%)", "blur": "50px", "ring-light": "rgb(0 0 0 / 5%)", "ring-dark": "rgb(255 255 255 / 5%)" }, "$type": "material", "$description": "Toggles, hover states, progress bars, form input backings" },
    "thin": { "$value": { "bg-light": "rgb(255 255 255 / 45%)", "bg-dark": "rgb(0 0 0 / 26%)", "blur": "50px", "ring-light": "rgb(0 0 0 / 5%)", "ring-dark": "rgb(255 255 255 / 8%)" }, "$type": "material", "$description": "Cards, ghost buttons, secondary containers" },
    "regular": { "$value": { "bg-light": "rgb(255 255 255 / 85%)", "bg-dark": "rgb(0 0 0 / 41%)", "blur": "50px", "ring-light": "rgb(0 0 0 / 10%)", "ring-dark": "rgb(255 255 255 / 10%)" }, "$type": "material", "$description": "Primary content cards, forms, search bars" },
    "thick": { "$value": { "bg-light": "rgb(255 255 255 / 95%)", "bg-dark": "rgb(0 0 0 / 60%)", "blur": "50px", "ring-light": "rgb(0 0 0 / 15%)", "ring-dark": "rgb(255 255 255 / 12%)" }, "$type": "material", "$description": "Modals, dropdowns, floating overlays" },
    "chrome": { "$value": { "bg-light": "rgb(255 255 255 / 75%)", "bg-dark": "rgb(24 24 27 / 90%)", "blur": "25px", "ring-light": "rgb(0 0 0 / 10%)", "ring-dark": "rgb(255 255 255 / 10%)" }, "$type": "material", "$description": "Persistent window chrome (navbar, mobile tab bar)" }
  },
  "motion": {
    "duration": {
      "instant": { "$value": "100ms", "$type": "duration" },
      "fast": { "$value": "150ms", "$type": "duration" },
      "base": { "$value": "200ms", "$type": "duration", "$description": "Default for buttons" },
      "slow": { "$value": "300ms", "$type": "duration" },
      "hero-fade": { "$value": "1s", "$type": "duration" }
    },
    "easing": {
      "standard": { "$value": "cubic-bezier(0.4, 0, 0.2, 1)", "$type": "cubicBezier" },
      "emphasized": { "$value": "cubic-bezier(0.2, 0, 0, 1)", "$type": "cubicBezier" },
      "linear": { "$value": "linear", "$type": "cubicBezier" }
    },
    "allowed-properties": {
      "$value": ["background", "box-shadow", "color", "opacity", "ring"],
      "$type": "stringArray",
      "$description": "Properties safe to transition. Never transition transform — causes compositing-layer jank + sub-pixel icon wobble."
    }
  },
  "focus": {
    "color-light": { "$value": "#64748b", "$type": "color", "$description": "slate-500" },
    "color-dark": { "$value": "#94a3b8", "$type": "color", "$description": "slate-400" },
    "width": { "$value": "2px", "$type": "dimension" },
    "offset-default": { "$value": "4px", "$type": "dimension" },
    "offset-link": { "$value": "8px", "$type": "dimension" },
    "offset-input": { "$value": "-2px", "$type": "dimension", "$description": "Inset on inputs" }
  },
  "breakpoint": {
    "$description": "Tailwind defaults. sm=640 collapses tabbar to mobile, hides nav-link labels.",
    "sm": { "$value": "640px", "$type": "dimension" },
    "md": { "$value": "768px", "$type": "dimension" },
    "lg": { "$value": "1024px", "$type": "dimension" },
    "xl": { "$value": "1280px", "$type": "dimension" },
    "2xl": { "$value": "1536px", "$type": "dimension" }
  },
  "target": {
    "min-interactive": { "$value": "44px", "$type": "dimension", "$description": "Minimum hit target — every interactive element" }
  }
}
